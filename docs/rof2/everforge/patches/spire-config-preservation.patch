+
+// Known omitted fields retain their normal omitempty behavior; only unknown
+// extension keys are copied from the existing configuration.
+func preserveUnknownFields(next, previous map[string]interface{}, typ reflect.Type) {
+    for typ.Kind() == reflect.Ptr { typ = typ.Elem() }
+    if typ.Kind() != reflect.Struct { return }
+    fields := map[string]reflect.Type{}
+    for i := 0; i < typ.NumField(); i++ {
+        field := typ.Field(i)
+        if field.PkgPath != "" { continue }
+        name := strings.Split(field.Tag.Get("json"), ",")[0]
+        if name == "-" { continue }
+        if name == "" { name = field.Name }
+        fields[name] = field.Type
+    }
+    for name, value := range previous {
+        field, known := fields[name]
+        if !known { next[name] = value; continue }
+        oldMap, okOld := value.(map[string]interface{})
+        newMap, okNew := next[name].(map[string]interface{})
+        if okOld && okNew { preserveUnknownFields(newMap, oldMap, field) }
+    }
+}
