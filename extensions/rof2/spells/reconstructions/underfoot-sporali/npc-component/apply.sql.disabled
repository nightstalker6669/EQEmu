 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109730 AND BINARY `Name` <=> BINARY 'Brax Nae Defender' AND BINARY `lore` <=> BINARY 'Used to defend the hive' FOR UPDATE;
 IF NOT(v_id <=> 109730) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109730 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109748 AND BINARY `Name` <=> BINARY 'Arms of the Cliknar' AND BINARY `lore` <=> BINARY 'Even in death they are strong' FOR UPDATE;
 IF NOT(v_id <=> 109748) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109748 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109749 AND BINARY `Name` <=> BINARY 'Hive Nurse''s Corrector' AND BINARY `lore` <=> BINARY 'Chitinous skin takes extra prodding' FOR UPDATE;
 IF NOT(v_id <=> 109749) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109749 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109772 AND BINARY `Name` <=> BINARY 'Crystallized Cliknar Eye' AND BINARY `lore` <=> BINARY 'Shines like a gem after treatment' FOR UPDATE;
 IF NOT(v_id <=> 109772) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109772 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109780 AND BINARY `Name` <=> BINARY 'Silken Sphere' AND BINARY `lore` <=> BINARY 'It has the feel of silk but the consistency of a gem' FOR UPDATE;
 IF NOT(v_id <=> 109780) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109780 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109785 AND BINARY `Name` <=> BINARY 'Ring of the Pious' AND BINARY `lore` <=> BINARY 'Allows for a special connection with one''s deity' FOR UPDATE;
 IF NOT(v_id <=> 109785) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109785 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109791 AND BINARY `Name` <=> BINARY 'Spiritbound Linked Mantle' AND BINARY `lore` <=> BINARY 'Drawn and connected to the shaman' FOR UPDATE;
 IF NOT(v_id <=> 109791) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109791 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109794 AND BINARY `Name` <=> BINARY 'Eye of the Elements' AND BINARY `lore` <=> BINARY 'A symbol from the core' FOR UPDATE;
 IF NOT(v_id <=> 109794) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109794 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109797 AND BINARY `Name` <=> BINARY 'Cloak of Spikes' AND BINARY `lore` <=> BINARY 'Sharp blades cascade along the back' FOR UPDATE;
 IF NOT(v_id <=> 109797) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109797 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109805 AND BINARY `Name` <=> BINARY 'Magmatic Deflector' AND BINARY `lore` <=> BINARY 'A fascinating shield used in Brell''s Temple creature trials' FOR UPDATE;
 IF NOT(v_id <=> 109805) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109805 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 109808 AND BINARY `Name` <=> BINARY 'Celestrium Greaves' AND BINARY `lore` <=> BINARY 'Not as cumbersome as you would imagine' FOR UPDATE;
 IF NOT(v_id <=> 109808) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 109808 drift'; END IF;
