-- DISABLED99ROW SOURCE COMPONENT ONLY; no CALL/installer/START/COMMIT.
-- Define routines before caller transaction; routine DDL may implicitly commit.
DELIMITER $$
CREATE PROCEDURE source_sporali_conditional_apply()
BEGIN
 DECLARE v_id BIGINT DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 OR COALESCE(@sporali_joint_source_authorized,0)<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali requires authorized caller held joint transaction'; END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name IN ('npc_types','loottable','lootdrop','loottable_entries','lootdrop_entries','spawngroup','spawnentry','spawn2','spawn_conditions') AND engine='InnoDB')<>9 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali requires nine transactional content tables'; END IF;
 IF EXISTS(SELECT 1 FROM `npc_types` WHERE id BETWEEN 485900 AND 485912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali npc_types namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `loottable` WHERE id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `lootdrop` WHERE id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `loottable_entries` WHERE loottable_id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable_entries namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `lootdrop_entries` WHERE lootdrop_id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop_entries namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawngroup` WHERE id BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawngroup namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE spawngroupID BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawnentry namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2` WHERE id BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn2 namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_conditions` WHERE zone='arthicrex' AND id=6202) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn_conditions namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE npcID BETWEEN 485900 AND 485912 AND NOT(spawngroupID BETWEEN 304053000 AND 304053020)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawnentry namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `pets` WHERE npcID BETWEEN 485900 AND 485912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali pets namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `merchantlist_temp` WHERE npcid BETWEEN 485900 AND 485912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali merchantlist_temp namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `global_loot` WHERE loottable_id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali global_loot namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2` WHERE spawngroupID BETWEEN 304053000 AND 304053020 AND NOT(id BETWEEN 304053000 AND 304053020)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn2 namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE spawngroupID BETWEEN 304053000 AND 304053020 AND NOT(npcID BETWEEN 485900 AND 485912)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawnentry namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2_disabled` WHERE spawn2_id BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn2_disabled namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `respawn_times` WHERE id BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali respawn_times namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_condition_values` WHERE zone='arthicrex' AND id=6202) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn_condition_values namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_events` WHERE zone='arthicrex' AND cond_id=6202) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn_events namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2` WHERE zone='arthicrex' AND _condition=6202 AND id<>304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn2 namespace collision'; END IF;
 IF EXISTS(SELECT 1 FROM spawnentry WHERE npcID BETWEEN 485900 AND 485912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali incoming NPC spawn consumer'; END IF;
 IF EXISTS(SELECT 1 FROM npc_types WHERE loottable_id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali incoming NPC loot consumer'; END IF;
 IF EXISTS(SELECT 1 FROM loottable_entries WHERE lootdrop_id BETWEEN 304053000 AND 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali incoming drop consumer'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 41310 AND BINARY `Name` <=> BINARY 'Sporochord Extract' AND `stackable` <=> 1 FOR UPDATE;
 IF NOT(v_id <=> 41310) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali existing item 41310 drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 41311 AND BINARY `Name` <=> BINARY 'Toximorel Compound' AND `stackable` <=> 1 FOR UPDATE;
