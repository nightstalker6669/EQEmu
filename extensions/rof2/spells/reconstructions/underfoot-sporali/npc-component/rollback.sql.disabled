 DELETE FROM `loottable_entries` WHERE loottable_id BETWEEN 304053000 AND 304053002;
 IF ROW_COUNT()<>3 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback loottable_entries delete count'; END IF;
 DELETE FROM `lootdrop_entries` WHERE lootdrop_id BETWEEN 304053000 AND 304053002;
 IF ROW_COUNT()<>13 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback lootdrop_entries delete count'; END IF;
 DELETE FROM `loottable` WHERE id BETWEEN 304053000 AND 304053002;
 IF ROW_COUNT()<>3 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback loottable delete count'; END IF;
