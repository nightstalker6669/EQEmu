-- DISABLED99ROW SOURCE COMPONENT ONLY; no CALL/installer/START/COMMIT.
-- Define routines before caller transaction; routine DDL may implicitly commit.
DELIMITER $$
CREATE PROCEDURE source_sporali_conditional_rollback()
BEGIN
 DECLARE v_id BIGINT DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 OR COALESCE(@sporali_joint_source_authorized,0)<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali requires authorized caller held joint transaction'; END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name IN ('npc_types','loottable','lootdrop','loottable_entries','lootdrop_entries','spawngroup','spawnentry','spawn2','spawn_conditions') AND engine='InnoDB')<>9 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali requires nine transactional content tables'; END IF;
 IF (SELECT COUNT(*) FROM `loottable` WHERE id BETWEEN 304053000 AND 304053002)<>3 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable count drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `loottable` WHERE `id` <=> 304053000 AND BINARY `name` <=> BINARY 'sporali_extract_chest' AND `mincash` <=> 0 AND `maxcash` <=> 0 AND `avgcoin` <=> 0 AND `done` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053000) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable postimage 0 drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `loottable` WHERE `id` <=> 304053001 AND BINARY `name` <=> BINARY 'sporali_compound_chest' AND `mincash` <=> 0 AND `maxcash` <=> 0 AND `avgcoin` <=> 0 AND `done` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable postimage 1 drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `loottable` WHERE `id` <=> 304053002 AND BINARY `name` <=> BINARY 'sporali_reward_chest' AND `mincash` <=> 0 AND `maxcash` <=> 0 AND `avgcoin` <=> 0 AND `done` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable postimage 2 drift'; END IF;
 IF (SELECT COUNT(*) FROM `lootdrop` WHERE id BETWEEN 304053000 AND 304053002)<>3 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop count drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `lootdrop` WHERE `id` <=> 304053000 AND BINARY `name` <=> BINARY 'sporali_extract_chest' AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053000) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop postimage 0 drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `lootdrop` WHERE `id` <=> 304053001 AND BINARY `name` <=> BINARY 'sporali_compound_chest' AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop postimage 1 drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `lootdrop` WHERE `id` <=> 304053002 AND BINARY `name` <=> BINARY 'sporali_reward_chest' AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop postimage 2 drift'; END IF;
 IF (SELECT COUNT(*) FROM `loottable_entries` WHERE loottable_id BETWEEN 304053000 AND 304053002)<>3 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable_entries count drift'; END IF;
 SET v_id=NULL;
 SELECT `loottable_id` INTO v_id FROM `loottable_entries` WHERE `loottable_id` <=> 304053000 AND `lootdrop_id` <=> 304053000 AND `multiplier` <=> 1 AND `droplimit` <=> 1 AND `mindrop` <=> 1 AND ABS(`probability`-(100))<=0.0002 FOR UPDATE;
 IF NOT(v_id <=> 304053000) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable_entries postimage 0 drift'; END IF;
 SET v_id=NULL;
 SELECT `loottable_id` INTO v_id FROM `loottable_entries` WHERE `loottable_id` <=> 304053001 AND `lootdrop_id` <=> 304053001 AND `multiplier` <=> 1 AND `droplimit` <=> 1 AND `mindrop` <=> 1 AND ABS(`probability`-(100))<=0.0002 FOR UPDATE;
 IF NOT(v_id <=> 304053001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable_entries postimage 1 drift'; END IF;
