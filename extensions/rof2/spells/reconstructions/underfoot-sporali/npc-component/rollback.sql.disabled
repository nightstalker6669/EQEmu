 IF NOT(v_id <=> 304053002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali loottable_entries postimage 2 drift'; END IF;
 IF (SELECT COUNT(*) FROM `lootdrop_entries` WHERE lootdrop_id BETWEEN 304053000 AND 304053002)<>13 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop_entries count drift'; END IF;
 SET v_id=NULL;
 SELECT `lootdrop_id` INTO v_id FROM `lootdrop_entries` WHERE `lootdrop_id` <=> 304053000 AND `item_id` <=> 41310 AND `item_charges` <=> 1 AND `equip_item` <=> 0 AND ABS(`chance`-(100))<=0.0002 AND ABS(`disabled_chance`-(0))<=0.0002 AND `trivial_min_level` <=> 0 AND `trivial_max_level` <=> 0 AND `multiplier` <=> 1 AND `npc_min_level` <=> 0 AND `npc_max_level` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
 IF NOT(v_id <=> 304053000) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali lootdrop_entries postimage 0 drift'; END IF;
 SET v_id=NULL;
 SELECT `lootdrop_id` INTO v_id FROM `lootdrop_entries` WHERE `lootdrop_id` <=> 304053001 AND `item_id` <=> 41311 AND `item_charges` <=> 1 AND `equip_item` <=> 0 AND ABS(`chance`-(100))<=0.0002 AND ABS(`disabled_chance`-(0))<=0.0002 AND `trivial_min_level` <=> 0 AND `trivial_max_level` <=> 0 AND `multiplier` <=> 1 AND `npc_min_level` <=> 0 AND `npc_max_level` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
