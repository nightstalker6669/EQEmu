 IF EXISTS(SELECT 1 FROM `spawn2` WHERE spawngroupID BETWEEN 304053000 AND 304053020 AND NOT(id BETWEEN 304053000 AND 304053020)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawn2 reference'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE spawngroupID BETWEEN 304053000 AND 304053020 AND NOT(npcID BETWEEN 485900 AND 485912)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawnentry reference'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2_disabled` WHERE spawn2_id BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawn2_disabled reference'; END IF;
 IF EXISTS(SELECT 1 FROM `respawn_times` WHERE id BETWEEN 304053000 AND 304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active respawn_times reference'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_condition_values` WHERE zone='arthicrex' AND id=6202) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawn_condition_values reference'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_events` WHERE zone='arthicrex' AND cond_id=6202) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawn_events reference'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2` WHERE zone='arthicrex' AND _condition=6202 AND id<>304053020) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawn2 reference'; END IF;
 IF EXISTS(SELECT 1 FROM npc_types WHERE loottable_id BETWEEN 304053000 AND 304053002 AND NOT(id BETWEEN 485900 AND 485912)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign NPC loot consumer'; END IF;
 IF EXISTS(SELECT 1 FROM loottable_entries WHERE lootdrop_id BETWEEN 304053000 AND 304053002 AND NOT(loottable_id BETWEEN 304053000 AND 304053002)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign drop consumer'; END IF;
 DELETE FROM `spawnentry` WHERE spawngroupID BETWEEN 304053000 AND 304053020;
 IF ROW_COUNT()<>21 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback spawnentry delete count'; END IF;
 DELETE FROM `spawn2` WHERE id BETWEEN 304053000 AND 304053020;
 IF ROW_COUNT()<>21 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback spawn2 delete count'; END IF;
 DELETE FROM `spawngroup` WHERE id BETWEEN 304053000 AND 304053020;
