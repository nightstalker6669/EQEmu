 SELECT `id` INTO v_id FROM `spawn_conditions` WHERE BINARY `zone` <=> BINARY 'arthicrex' AND `id` <=> 6202 AND `value` <=> 0 AND `onchange` <=> 3 AND BINARY `name` <=> BINARY 'sporali_owned_reward_chest' FOR UPDATE;
 IF NOT(v_id <=> 6202) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali spawn_conditions postimage 0 drift'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE npcID BETWEEN 485900 AND 485912 AND NOT(spawngroupID BETWEEN 304053000 AND 304053020)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Sporali rollback foreign/active spawnentry reference'; END IF;
