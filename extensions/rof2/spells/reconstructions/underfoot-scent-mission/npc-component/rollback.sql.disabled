 -- Runtime/DZ/task consumers must already be quiesced by their owners; never clear player or respawn state here.
 DELETE FROM `spawnentry` WHERE spawngroupID BETWEEN 304051000 AND 304051027;
 IF ROW_COUNT()<>28 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback spawnentry delete count'; END IF;
 DELETE FROM `spawn2` WHERE id BETWEEN 304051000 AND 304051027;
 IF ROW_COUNT()<>28 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback spawn2 delete count'; END IF;
 DELETE FROM `spawngroup` WHERE id BETWEEN 304051000 AND 304051027;
 IF ROW_COUNT()<>28 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback spawngroup delete count'; END IF;
 DELETE FROM `npc_types` WHERE id BETWEEN 482900 AND 482911;
 IF ROW_COUNT()<>12 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback npc_types delete count'; END IF;
 DELETE FROM `loottable_entries` WHERE loottable_id BETWEEN 304051000 AND 304051005;
 IF ROW_COUNT()<>6 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback loottable_entries delete count'; END IF;
 DELETE FROM `lootdrop_entries` WHERE lootdrop_id BETWEEN 304051000 AND 304051005;
 IF ROW_COUNT()<>16 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback lootdrop_entries delete count'; END IF;
 DELETE FROM `loottable` WHERE id BETWEEN 304051000 AND 304051005;
 IF ROW_COUNT()<>6 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback loottable delete count'; END IF;
 DELETE FROM `lootdrop` WHERE id BETWEEN 304051000 AND 304051005;
 IF ROW_COUNT()<>6 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback lootdrop delete count'; END IF;
 DELETE FROM `spawn_conditions` WHERE zone='underquarry' AND id=6201;
 IF ROW_COUNT()<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent rollback spawn_conditions delete count'; END IF;
