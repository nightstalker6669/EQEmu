-- DISABLED SOURCE ONLY: no CALL, installer, migration registration or transaction start/commit.
-- Define routine BEFORE the caller transaction (routine DDL implicitly commits).
DELIMITER $$
CREATE PROCEDURE source_scent_npc_conditional_rollback()
BEGIN
 DECLARE v_id BIGINT DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 OR COALESCE(@scent_joint_source_authorized,0)<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent requires authorized caller-held integrated transaction'; END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name IN ('npc_types','spawngroup','spawnentry','spawn2','loottable','loottable_entries','lootdrop','lootdrop_entries','spawn_conditions') AND engine='InnoDB')<>9 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent requires nine transactional content tables'; END IF;
 -- Guard every owned row and reject extra rows BEFORE any rollback writes.
 IF (SELECT COUNT(*) FROM `npc_types` WHERE id BETWEEN 482900 AND 482911)<>12 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent npc_types owned row count drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `npc_types` WHERE `id` <=> 482900 AND BINARY `name` <=> BINARY 'Lady_Envy' AND BINARY `lastname` <=> BINARY '' AND `level` <=> 88 AND `race` <=> 638 AND `class` <=> 1 AND `bodytype` <=> 1 AND `hp` <=> 1200000 AND `mana` <=> 0 AND `gender` <=> 0 AND `texture` <=> 0 AND `helmtexture` <=> 0 AND `herosforgemodel` <=> 0 AND ABS(`size`-(6))<=0.0002 AND `hp_regen_rate` <=> 0 AND `hp_regen_per_second` <=> 0 AND `mana_regen_rate` <=> 0 AND `loottable_id` <=> 304051004 AND `merchant_id` <=> 0 AND `greed` <=> 0 AND `alt_currency_id` <=> 0 AND `npc_spells_id` <=> 0 AND `npc_spells_effects_id` <=> 0 AND `npc_faction_id` <=> 0 AND `adventure_template_id` <=> 0 AND `trap_template` <=> 0 AND `mindmg` <=> 1000 AND `maxdmg` <=> 7200 AND `attack_count` <=> -1 AND BINARY `npcspecialattks` <=> BINARY '' AND BINARY `special_abilities` <=> BINARY '1,1' AND `aggroradius` <=> 0 AND `assistradius` <=> 0 AND `face` <=> 1 AND `luclin_hairstyle` <=> 1 AND `luclin_haircolor` <=> 1 AND `luclin_eyecolor` <=> 1 AND `luclin_eyecolor2` <=> 1 AND `luclin_beardcolor` <=> 1 AND `luclin_beard` <=> 0 AND `drakkin_heritage` <=> 0 AND `drakkin_tattoo` <=> 0 AND `drakkin_details` <=> 0 AND `armortint_id` <=> 0 AND `armortint_red` <=> 0 AND `armortint_green` <=> 0 AND `armortint_blue` <=> 0 AND `d_melee_texture1` <=> 0 AND `d_melee_texture2` <=> 0 AND BINARY `ammo_idfile` <=> BINARY 'IT10' AND `prim_melee_type` <=> 28 AND `sec_melee_type` <=> 28 AND `ranged_type` <=> 7 AND ABS(`runspeed`-(1.25))<=0.0002 AND `MR` <=> 0 AND `CR` <=> 0 AND `DR` <=> 0 AND `FR` <=> 0 AND `PR` <=> 0 AND `Corrup` <=> 0 AND `PhR` <=> 0 AND `see_invis` <=> 0 AND `see_invis_undead` <=> 0 AND `qglobal` <=> 0 AND `AC` <=> 800 AND `npc_aggro` <=> 0 AND `spawn_limit` <=> 0 AND ABS(`attack_speed`-(0))<=0.0002 AND `attack_delay` <=> 30 AND `findable` <=> 0 AND `STR` <=> 350 AND `STA` <=> 350 AND `DEX` <=> 350 AND `AGI` <=> 350 AND `_INT` <=> 350 AND `WIS` <=> 350 AND `CHA` <=> 350 AND `see_hide` <=> 0 AND `see_improved_hide` <=> 0 AND `trackable` <=> 1 AND `isbot` <=> 0 AND `exclude` <=> 1 AND `ATK` <=> 700 AND `Accuracy` <=> 0 AND `Avoidance` <=> 0 AND `slow_mitigation` <=> 0 AND `version` <=> 1 AND `maxlevel` <=> 0 AND `scalerate` <=> 100 AND `private_corpse` <=> 0 AND `unique_spawn_by_name` <=> 0 AND `underwater` <=> 0 AND `isquest` <=> 1 AND `emoteid` <=> 0 AND ABS(`spellscale`-(100))<=0.0002 AND ABS(`healscale`-(100))<=0.0002 AND `no_target_hotkey` <=> 0 AND `raid_target` <=> 0 AND `armtexture` <=> 0 AND `bracertexture` <=> 0 AND `handtexture` <=> 0 AND `legtexture` <=> 0 AND `feettexture` <=> 0 AND `light` <=> 0 AND ABS(`walkspeed`-(0))<=0.0002 AND `peqid` <=> 0 AND `unique_` <=> 0 AND `fixed` <=> 0 AND `ignore_despawn` <=> 0 AND `show_name` <=> 1 AND `untargetable` <=> 0 AND `charm_ac` <=> 0 AND `charm_min_dmg` <=> 0 AND `charm_max_dmg` <=> 0 AND `charm_attack_delay` <=> 0 AND `charm_accuracy_rating` <=> 0 AND `charm_avoidance_rating` <=> 0 AND `charm_atk` <=> 0 AND `skip_global_loot` <=> 1 AND `rare_spawn` <=> 0 AND `stuck_behavior` <=> 0 AND `model` <=> 0 AND `flymode` <=> -1 AND `always_aggro` <=> 0 AND `exp_mod` <=> 100 AND `heroic_strikethrough` <=> 0 AND `faction_amount` <=> 0 AND `keeps_sold_items` <=> 1 AND `is_parcel_merchant` <=> 0 AND `multiquest_enabled` <=> 0 AND `npc_tint_id` <=> 0 FOR UPDATE;
 IF NOT(v_id <=> 482900) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent npc_types postimage 0 drift'; END IF;
 SET v_id=NULL;
