-- DISABLED SOURCE ONLY: no CALL, installer, migration registration or transaction start/commit.
-- Define routine BEFORE the caller transaction (routine DDL implicitly commits).
DELIMITER $$
CREATE PROCEDURE source_scent_npc_conditional_apply()
BEGIN
 DECLARE v_id BIGINT DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 OR COALESCE(@scent_joint_source_authorized,0)<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent requires authorized caller-held integrated transaction'; END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name IN ('npc_types','spawngroup','spawnentry','spawn2','loottable','loottable_entries','lootdrop','lootdrop_entries','spawn_conditions') AND engine='InnoDB')<>9 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent requires nine transactional content tables'; END IF;
 -- Recheck exact reserved identifiers and incoming references; no overwrites/upserts.
 IF EXISTS(SELECT 1 FROM `npc_types` WHERE id BETWEEN 482900 AND 482911 OR loottable_id BETWEEN 304051000 AND 304051005) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent npc_types namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE npcID BETWEEN 482900 AND 482911 OR spawngroupID BETWEEN 304051000 AND 304051027) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawnentry namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawngroup` WHERE id BETWEEN 304051000 AND 304051027) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawngroup namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2` WHERE id BETWEEN 304051000 AND 304051027 OR spawngroupID BETWEEN 304051000 AND 304051027) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawn2 namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2_disabled` WHERE spawn2_id BETWEEN 304051000 AND 304051027) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawn2_disabled namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `respawn_times` WHERE id BETWEEN 304051000 AND 304051027) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent respawn_times namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `loottable` WHERE id BETWEEN 304051000 AND 304051005) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent loottable namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `loottable_entries` WHERE loottable_id BETWEEN 304051000 AND 304051005 OR lootdrop_id BETWEEN 304051000 AND 304051005) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent loottable_entries namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `lootdrop` WHERE id BETWEEN 304051000 AND 304051005) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent lootdrop namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `lootdrop_entries` WHERE lootdrop_id BETWEEN 304051000 AND 304051005) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent lootdrop_entries namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `pets` WHERE npcID BETWEEN 482900 AND 482911) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent pets namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `merchantlist_temp` WHERE npcid BETWEEN 482900 AND 482911) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent merchantlist_temp namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `global_loot` WHERE loottable_id BETWEEN 304051000 AND 304051005) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent global_loot namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_conditions` WHERE zone='underquarry' AND id=6201) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawn_conditions namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_condition_values` WHERE zone='underquarry' AND id=6201) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawn_condition_values namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn_events` WHERE zone='underquarry' AND cond_id=6201) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawn_events namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawn2` WHERE zone='underquarry' AND _condition=6201) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent spawn2 namespace/reference collision'; END IF;
 -- Lock the sixteen existing item identities before any content write.
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 41974 AND BINARY `Name` <=> BINARY 'Counterrotating Flywheel Piston' AND BINARY `lore` <=> BINARY 'A high-precision clockwork part.' AND `itemtype` <=> 11 FOR UPDATE;
 IF NOT(v_id <=> 41974) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 41974 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 41975 AND BINARY `Name` <=> BINARY 'Difference Machine Gearbox' AND BINARY `lore` <=> BINARY 'An ornate box of intricate metalwork.' AND `itemtype` <=> 11 FOR UPDATE;
 IF NOT(v_id <=> 41975) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 41975 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 41976 AND BINARY `Name` <=> BINARY 'Servogizmonic Manipulator' AND BINARY `lore` <=> BINARY 'A sturdy clockwork part designed for lifting and tweaking.' AND `itemtype` <=> 11 FOR UPDATE;
 IF NOT(v_id <=> 41976) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 41976 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 41977 AND BINARY `Name` <=> BINARY 'Pellucinite Cylinder' AND BINARY `lore` <=> BINARY 'A clockwork part which converts fuel into movement.' AND `itemtype` <=> 11 FOR UPDATE;
 IF NOT(v_id <=> 41977) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 41977 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 41978 AND BINARY `Name` <=> BINARY 'Instructions' AND BINARY `lore` <=> BINARY 'A white scroll with over-deliberate blocky writing.' AND `itemtype` <=> 11 FOR UPDATE;
 IF NOT(v_id <=> 41978) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 41978 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109741 AND BINARY `Name` <=> BINARY 'Tracker''s Skullripper' AND BINARY `lore` <=> BINARY 'This wicked axe blade easily splits skulls' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
 IF NOT(v_id <=> 109741) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 109741 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109747 AND BINARY `Name` <=> BINARY 'Sandstone Knuckles' AND BINARY `lore` <=> BINARY 'Made from the hardest sandstone' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
 IF NOT(v_id <=> 109747) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 109747 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109767 AND BINARY `Name` <=> BINARY 'Eye of Conquest' AND BINARY `lore` <=> BINARY 'Taken from a hunter''s greatest conquest' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
 IF NOT(v_id <=> 109767) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 109767 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109779 AND BINARY `Name` <=> BINARY 'Pewter Teardrop' AND BINARY `lore` <=> BINARY 'Smooth pewter, tears of a metal golem' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
 IF NOT(v_id <=> 109779) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 109779 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109790 AND BINARY `Name` <=> BINARY 'Shadowsilk Sash' AND BINARY `lore` <=> BINARY 'Whispers as it stretches' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
 IF NOT(v_id <=> 109790) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 109790 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109793 AND BINARY `Name` <=> BINARY 'Clay-caked Veil' AND BINARY `lore` <=> BINARY 'The gems are dirtied by a layer of clay' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
 IF NOT(v_id <=> 109793) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Scent existing item 109793 identity drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM items WHERE `id` <=> 109795 AND BINARY `Name` <=> BINARY 'Unearthed Belt' AND BINARY `lore` <=> BINARY 'Ancient power flows through this belt' AND `reqlevel` <=> 83 AND `reclevel` <=> 85 FOR UPDATE;
