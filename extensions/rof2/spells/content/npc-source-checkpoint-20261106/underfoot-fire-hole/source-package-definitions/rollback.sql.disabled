-- DISABLED87ROW DEFINITION SOURCE ONLY; no CALL/installer/START/COMMIT. Define before caller transaction.
DELIMITER $$
CREATE PROCEDURE source_fire_hole_npc_definitions_rollback()
BEGIN
 DECLARE v_id BIGINT DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 OR COALESCE(@fire_hole_definition_source_authorized,0)<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='FireHole requires authorized caller-held joint transaction'; END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name IN ('loottable','lootdrop','loottable_entries','lootdrop_entries','npc_types') AND engine='InnoDB')<>5 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='FireHole requires five transactional definition tables'; END IF;
 IF (SELECT COUNT(*) FROM `loottable` WHERE id BETWEEN 304062000 AND 304062012)<>13 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='FireHole loottable count drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `loottable` WHERE `id` <=> 304062000 AND BINARY `name` <=> BINARY 'fire_hole_drop_ancient_gigyn_colossus' AND `mincash` <=> 0 AND `maxcash` <=> 0 AND `avgcoin` <=> 0 AND `done` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
