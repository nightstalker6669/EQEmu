 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 110243 AND BINARY `Name` <=> BINARY 'Mad Mephit''s Blade' AND BINARY `lore` <=> BINARY 'It''s only dangerous on one end' FOR UPDATE;
 IF NOT(v_id <=> 110243) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110243 identity drift'; END IF;
 SET v_id=NULL;
