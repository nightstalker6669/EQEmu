 IF NOT(v_id <=> 110246) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110246 identity drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 110267 AND BINARY `Name` <=> BINARY 'Workmaster''s Horn Fragment' AND BINARY `lore` <=> BINARY 'Chipped from the horn of the Mephit Workmaster' FOR UPDATE;
 IF NOT(v_id <=> 110267) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110267 identity drift'; END IF;
 SET v_id=NULL;
