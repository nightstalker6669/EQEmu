 IF NOT(v_id <=> 110273) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110273 identity drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 110278 AND BINARY `Name` <=> BINARY 'Striped Agate of Devotion' AND BINARY `lore` <=> BINARY 'This stone was pried out of an engagement ring' FOR UPDATE;
 IF NOT(v_id <=> 110278) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110278 identity drift'; END IF;
 SET v_id=NULL;
