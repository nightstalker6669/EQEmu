-- DISABLED32ROW DEFINITION SOURCE ONLY; no CALL/installer/START/COMMIT. Define before caller transaction.
DELIMITER $$
CREATE PROCEDURE source_bonfire_npc_definitions_apply()
BEGIN
 DECLARE v_id BIGINT DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 OR COALESCE(@bonfire_definition_source_authorized,0)<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire requires authorized caller-held joint transaction'; END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name IN ('loottable','lootdrop','loottable_entries','lootdrop_entries','npc_types') AND engine='InnoDB')<>5 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire requires five transactional definition tables'; END IF;
 IF EXISTS(SELECT 1 FROM `npc_types` WHERE id BETWEEN 487900 AND 487912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire npc_types namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `loottable` WHERE id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire loottable namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `lootdrop` WHERE id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire lootdrop namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `loottable_entries` WHERE loottable_id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire loottable_entries namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `lootdrop_entries` WHERE lootdrop_id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire lootdrop_entries namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `spawnentry` WHERE npcID BETWEEN 487900 AND 487912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire spawnentry namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `pets` WHERE npcID BETWEEN 487900 AND 487912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire pets namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `merchantlist_temp` WHERE npcid BETWEEN 487900 AND 487912) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire merchantlist_temp namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM `global_loot` WHERE loottable_id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire global_loot namespace/reference collision'; END IF;
 IF EXISTS(SELECT 1 FROM npc_types WHERE loottable_id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire incoming NPC loot reference'; END IF;
 IF EXISTS(SELECT 1 FROM loottable_entries WHERE lootdrop_id BETWEEN 304063000 AND 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire incoming lootdrop reference'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 110230 AND BINARY `Name` <=> BINARY 'Runed Longsword' AND BINARY `lore` <=> BINARY 'The symbols glow with every strike' FOR UPDATE;
 IF NOT(v_id <=> 110230) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110230 identity drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 110234 AND BINARY `Name` <=> BINARY 'Anvil Forged Axe' AND BINARY `lore` <=> BINARY 'Large axe, forged by "Anvil''s hand"' FOR UPDATE;
 IF NOT(v_id <=> 110234) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire existing item110234 identity drift'; END IF;
 SET v_id=NULL;
 SELECT id INTO v_id FROM items WHERE `id` <=> 110242 AND BINARY `Name` <=> BINARY 'Ancill''s Hatchet' AND BINARY `lore` <=> BINARY 'Maybe he was using it incorrectly' FOR UPDATE;
