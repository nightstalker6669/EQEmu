 IF NOT(v_id <=> 304063001) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire lootdrop full postimage1 drift'; END IF;
 IF (SELECT COUNT(*) FROM `loottable_entries` WHERE loottable_id BETWEEN 304063000 AND 304063001)<>2 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire loottable_entries count drift'; END IF;
 SET v_id=NULL;
 SELECT `loottable_id` INTO v_id FROM `loottable_entries` WHERE `loottable_id` <=> 304063000 AND `lootdrop_id` <=> 304063000 AND `multiplier` <=> 1 AND `droplimit` <=> 1 AND `mindrop` <=> 1 AND ABS(`probability`-(100))<=0.0002 FOR UPDATE;
 IF NOT(v_id <=> 304063000) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Bonfire loottable_entries full postimage0 drift'; END IF;
 SET v_id=NULL;
 SELECT `loottable_id` INTO v_id FROM `loottable_entries` WHERE `loottable_id` <=> 304063001 AND `lootdrop_id` <=> 304063001 AND `multiplier` <=> 1 AND `droplimit` <=> 1 AND `mindrop` <=> 1 AND ABS(`probability`-(100))<=0.0002 FOR UPDATE;
