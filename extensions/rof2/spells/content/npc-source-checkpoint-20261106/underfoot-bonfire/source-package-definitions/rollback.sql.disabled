 SELECT `lootdrop_id` INTO v_id FROM `lootdrop_entries` WHERE `lootdrop_id` <=> 304063000 AND `item_id` <=> 111900 AND `item_charges` <=> 1 AND `equip_item` <=> 0 AND ABS(`chance`-(100))<=0.0002 AND ABS(`disabled_chance`-(0))<=0.0002 AND `trivial_min_level` <=> 0 AND `trivial_max_level` <=> 0 AND `multiplier` <=> 1 AND `npc_min_level` <=> 0 AND `npc_max_level` <=> 0 AND `min_expansion` <=> 16 AND `max_expansion` <=> -1 AND `content_flags` <=> NULL AND `content_flags_disabled` <=> NULL FOR UPDATE;
