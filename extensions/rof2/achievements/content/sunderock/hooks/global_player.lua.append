function event_player_pickup(e)
 if sunderock_previous_player_pickup then local r=sunderock_previous_player_pickup(e);if r and r~=0 then return r end end
 return require('achievement_quest_sunderock').pickup(e)
end
local sunderock_previous_loot=event_loot
function event_loot(e)
 if sunderock_previous_loot then local r=sunderock_previous_loot(e);if r and r~=0 then return r end end
 return require('achievement_quest_sunderock').loot(e)
end
local sunderock_previous_timer=event_timer
function event_timer(e)
 if require('achievement_quest_sunderock').timer(e)then return end
 if sunderock_previous_timer then return sunderock_previous_timer(e)end
end
