-- Preserve all previous player callbacks and vetoes.
local sunderock_previous_task_accepted=event_task_accepted
function event_task_accepted(e)
 if sunderock_previous_task_accepted then local r=sunderock_previous_task_accepted(e);if r and r~=0 then return r end end
 return require('achievement_quest_sunderock').resume(e)
end
local sunderock_previous_task_complete=event_task_complete
function event_task_complete(e)
 if sunderock_previous_task_complete then local r=sunderock_previous_task_complete(e);if r and r~=0 then return r end end
 return require('achievement_quest_sunderock').complete(e)
end
