
-- Complete disabled Steppes task/scene routes; preserve existing player handlers.
local steppes_previous_task_accepted=event_task_accepted
function event_task_accepted(e)
 if steppes_previous_task_accepted then local r=steppes_previous_task_accepted(e);if r and r~=0 then return r end end
 return require('achievement_quest_steppes').accepted(e)
end
local steppes_previous_task_complete=event_task_complete
function event_task_complete(e)
 if steppes_previous_task_complete then local r=steppes_previous_task_complete(e);if r and r~=0 then return r end end
 return require('achievement_quest_steppes').complete(e)
end
