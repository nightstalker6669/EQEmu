 return require('achievement_quest_steppes').click_door(e)
end
local steppes_previous_timer=event_timer
function event_timer(e)
 if require('achievement_quest_steppes').timer(e)then return end
 if steppes_previous_timer then return steppes_previous_timer(e)end
end
