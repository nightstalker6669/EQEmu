
-- Append candidate only; preserve existing Mesa/housing/global callbacks.
local steppes_encounter_previous_killed_merit=event_killed_merit
function event_killed_merit(e)
 if steppes_encounter_previous_killed_merit then local r=steppes_encounter_previous_killed_merit(e);if r and r~=0 then return r end end
 return require('achievement_quest_steppes').killed_merit(e)
end
local steppes_encounter_previous_death_complete=event_death_complete
function event_death_complete(e)
 if steppes_encounter_previous_death_complete then local r=steppes_encounter_previous_death_complete(e);if r and r~=0 then return r end end
 return require('achievement_quest_steppes').death_complete(e)
end
local steppes_encounter_previous_despawn=event_despawn
function event_despawn(e)
 if steppes_encounter_previous_despawn then local r=steppes_encounter_previous_despawn(e);if r and r~=0 then return r end end
 return require('achievement_quest_steppes').despawn(e)
end
local steppes_encounter_previous_timer=event_timer
function event_timer(e)
 if steppes_encounter_previous_timer then local r=steppes_encounter_previous_timer(e);if r and r~=0 then return r end end
 return require('achievement_quest_steppes').timer(e)
end
