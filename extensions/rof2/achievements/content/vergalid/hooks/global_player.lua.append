-- Preserve earlier player callbacks and their vetoes.
local vergalid_previous_enter_zone=event_enter_zone
function event_enter_zone(e)
 if vergalid_previous_enter_zone then local r=vergalid_previous_enter_zone(e);if r and r~=0 then return r end end
 return require('achievement_quest_vergalid').resume(e)
end
local vergalid_previous_task_accepted=event_task_accepted
function event_task_accepted(e)
 if vergalid_previous_task_accepted then local r=vergalid_previous_task_accepted(e);if r and r~=0 then return r end end
 return require('achievement_quest_vergalid').resume(e)
end
