+-- Training-only Alaran achievement predicates. The ordinary Words combine
+-- route and relog persistence passed native RoF2 checks. This Boolean server
+-- representation is not a recovered Live numeric progress-counter claim.
+return {
+ enabled=true,
+ trigger_verified=true,
+ achievement_id=1900049,
+ component_type=1,
+ component_id=1900049,
+ language_id=25, -- native internal language index, NOT MQ one-based26 or a skill value
+ language_required=100,
+ progress_value=1, -- proposed Boolean credit only when native language>=100
+ required_count=1,
+ -- Four period-supported siblings; no duplicate Master criterion.
+ siblings={
+  {achievement_id=1900045,component_id=1900045,threshold=25},
+  {achievement_id=1900046,component_id=1900046,threshold=50},
+  {achievement_id=1900047,component_id=1900047,threshold=71},
