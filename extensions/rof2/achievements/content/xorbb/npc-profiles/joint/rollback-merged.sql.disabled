-- DISABLED SOURCE COMPONENT: no CALL, installer, migration registration, START/COMMIT.
-- Run only within Achievements' already-held integrated MariaDB/InnoDB transaction.
-- Create routine definitions before START TRANSACTION; routine DDL may implicitly commit.
DELIMITER $$
CREATE PROCEDURE source_xorbb136_caster24_rollback()
BEGIN
 DECLARE v_id BIGINT UNSIGNED DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 THEN
  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Xorbb joint component requires caller held transaction';
 END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE()
     AND table_name IN ('npc_types','npc_spells','npc_spells_entries') AND engine='InnoDB')<>3 THEN
  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Xorbb joint tables must be transactional';
 END IF;
 -- Guard every owned postimage before rollback writes; allow unrelated later loot/other fields to survive.
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `npc_types` WHERE `id` <=> 753002 AND BINARY `name` <=> BINARY 'a_groundswell_elemental' AND `level` <=> 99 AND `race` <=> 476 AND `class` <=> 1 AND `hp` <=> 1800000 AND `mindmg` <=> 1500 AND `maxdmg` <=> 10000 AND `AC` <=> 1800 AND `ATK` <=> 1600 FOR UPDATE;
 IF NOT(v_id <=> 753002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Xorbb rollback NPC 753002 drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `npc_types` WHERE `id` <=> 753004 AND BINARY `name` <=> BINARY 'a_groundswell_elemental' AND `level` <=> 98 AND `race` <=> 476 AND `class` <=> 1 AND `hp` <=> 1800000 AND `mindmg` <=> 1500 AND `maxdmg` <=> 10000 AND `AC` <=> 1800 AND `ATK` <=> 1600 FOR UPDATE;
