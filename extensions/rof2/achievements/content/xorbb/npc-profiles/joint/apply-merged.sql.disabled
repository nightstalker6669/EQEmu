-- DISABLED SOURCE COMPONENT: no CALL, installer, migration registration, START/COMMIT.
-- Run only within Achievements' already-held integrated MariaDB/InnoDB transaction.
-- Create routine definitions before START TRANSACTION; routine DDL may implicitly commit.
DELIMITER $$
CREATE PROCEDURE source_xorbb136_caster24_apply()
BEGIN
 DECLARE v_id BIGINT UNSIGNED DEFAULT NULL;
 DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id=NULL;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; RESIGNAL; END;
 IF @@in_transaction<>1 THEN
  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Xorbb joint component requires caller held transaction';
 END IF;
 IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE()
     AND table_name IN ('npc_types','npc_spells','npc_spells_entries') AND engine='InnoDB')<>3 THEN
  SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Xorbb joint tables must be transactional';
 END IF;
 -- ALL INITIAL NPC UNION GUARDS HELD BEFORE ANY WRITES (one pass, no stale second HP guards).
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `npc_types` WHERE `id` <=> 753002 AND BINARY `name` <=> BINARY 'a_groundswell_elemental' AND `level` <=> 99 AND `class` <=> 1 AND `race` <=> 476 AND `hp` <=> 10791 AND `mindmg` <=> 0 AND `maxdmg` <=> 4 AND `AC` <=> 486 AND `ATK` <=> 0 AND `npc_spells_id` <=> 0 AND `loottable_id` <=> 0 FOR UPDATE;
 IF NOT(v_id <=> 753002) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Xorbb initial NPC 753002 drift'; END IF;
 SET v_id=NULL;
 SELECT `id` INTO v_id FROM `npc_types` WHERE `id` <=> 753004 AND BINARY `name` <=> BINARY 'a_groundswell_elemental' AND `level` <=> 98 AND `class` <=> 1 AND `race` <=> 476 AND `hp` <=> 10584 AND `mindmg` <=> 0 AND `maxdmg` <=> 4 AND `AC` <=> 482 AND `ATK` <=> 0 AND `npc_spells_id` <=> 0 AND `loottable_id` <=> 0 FOR UPDATE;
