 OR EXISTS(SELECT 1 FROM ground_spawns WHERE zoneid=753 AND version IN(-1,0)AND item IN(68485,68571,68572))
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Ground namespace or duplicate quest source collision';END IF;
 IF(SELECT COUNT(*)FROM ground_spawns WHERE zoneid=753 AND version IN(-1,0))+26>64
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Ground loader capacity64 exceeded; preserve unrelated content';END IF;
 IF(SELECT COUNT(*)FROM items WHERE(id=68485 AND Name='Wiry Pondweed'AND idfile='IT11074')OR(id=68571 AND Name='Ragweed'AND idfile='IT11066')OR(id=68572 AND Name='Ground Black Pepper'AND idfile='IT11064'))<>3
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Original item/model mismatch';END IF;
