-- UNAPPLIED candidate source, NOT an independently installable upgrade.
-- No SQL is executed by this generator. This file is not registered as migration.
-- Outer required package must verify deployed capacity64, exact source/version,
-- quiescent zone/cache plan and recoverable backup BEFORE setting authorization.
-- Session variables are caller attestations, not binary/capability detection.
-- This source candidate is SAME-SCHEMA ONLY. Runtime object_contents must be
-- authoritative; a content snapshot with an empty copy is not custody proof.
DELIMITER $$
CREATE PROCEDURE xorbb_garden_conversion_candidate()
BEGIN
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK;RESIGNAL;END;
 IF COALESCE(@rof2_xorbb_ground_conversion_authorized,0)<>1
 OR COALESCE(@rof2_deployed_ground_capacity,0)<64
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Coordinated conversion/capacity64 deployment not attested';END IF;
 IF @rof2_authoritative_runtime_schema IS NULL OR BINARY @rof2_authoritative_runtime_schema<>BINARY DATABASE()
 OR @rof2_authoritative_content_schema IS NULL OR BINARY @rof2_authoritative_content_schema<>BINARY DATABASE()
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Same-schema candidate only; split runtime contents require integrated guard';END IF;
 IF(SELECT COUNT(*)FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE()
 AND TABLE_NAME IN('object','object_contents','ground_spawns')AND ENGINE='InnoDB')<>3
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Transactional world tables required';END IF;
 START TRANSACTION;
 IF EXISTS(SELECT 1 FROM object_contents WHERE parentid IN(228396,228397,228398,228399,228400,228401,228402,228403,228404,228405,228406,228407,228408,228409,228410,228411,228412,228413,228414,228416,228417,228418,228419,228420,228421,228422))
 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Original world object has stored contents; preserve and stop';END IF;
