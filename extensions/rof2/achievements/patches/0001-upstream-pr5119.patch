+				.reward_set_id = row[0]
+					? static_cast<uint32_t>(strtoul(row[0], nullptr, 10))
+					: 0,
+				.option_id = row[1]
+					? static_cast<uint32_t>(strtoul(row[1], nullptr, 10))
+					: 0,
+				.sequence = row[2]
+					? static_cast<uint32_t>(strtoul(row[2], nullptr, 10))
+					: 0,
+				.reward_id = row[3]
+					? static_cast<uint32_t>(strtoul(row[3], nullptr, 10))
+					: 0
+			});
+		}
+		return true;
+	}
+
+};
