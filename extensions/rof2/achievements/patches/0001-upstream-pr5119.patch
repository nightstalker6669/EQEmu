+            _criterion_behavior(component.component_type)
+            if component is not None
+            else None
+        )
+        if component is None or behavior is None:
+            raise ResourceError(
+                "reviewed quest-manual component no longer has a valid "
+                f"state-bearing policy: {key}"
+            )
+
+        criteria.append(
+            EvaluationCriterion(
