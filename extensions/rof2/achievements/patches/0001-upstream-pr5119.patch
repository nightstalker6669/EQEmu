+def _without_reviewed_item_name_criteria(
+    criteria: Sequence[ItemNameCriterion],
+) -> Tuple[ItemNameCriterion, ...]:
+    reviewed_keys = set(REVIEWED_OWN_ITEM_TARGETS) | set(
+        REVIEWED_SCRIPT_COMPONENTS
+    )
+    return tuple(
+        criterion
+        for criterion in criteria
+        if (
