+def _reviewed_voa_dependency_targets(
+    resources: ResourceSet,
+    selected_ids: frozenset[int],
+    components_by_achievement: dict[int, List[Component]],
+    component_counts: dict[int, int],
+) -> dict[Tuple[int, int, int], int]:
+    targets: dict[Tuple[int, int, int], int] = {}
+    for key, identity in REVIEWED_VOA_DEPENDENCY_ALIASES.items():
+        parent_id, component_type, component_id = key
+        parent_name, sequence, component_name, child_id, child_name = identity
+        # Do not bypass historical exclusion or unresolved content admission.
+        if parent_id not in selected_ids or child_id not in selected_ids:
+            continue
+        parents = [row for row in resources.achievements
+                   if row.achievement_id == parent_id]
+        children = [row for row in resources.achievements
+                    if row.achievement_id == child_id]
+        named_children = [row for row in resources.achievements
+                          if row.achievement_id in selected_ids
+                          and row.name == child_name]
+        components = [row for row in components_by_achievement.get(parent_id, ())
+                      if row.component_id == component_id]
+        if (
+            len(parents) != 1 or parents[0].name != parent_name
+            or len(children) != 1 or children[0].name != child_name
+            or len(named_children) != 1
+            or len(components) != 1
+            or components[0] != Component(
+                parent_id, sequence, component_type, component_id, component_name
+            )
+            or component_counts.get(component_id) != 1
+        ):
+            raise ResourceError(
+                f"reviewed VoA dependency identity drift: {key} -> {child_id}"
+            )
+        targets[key] = child_id
+    return targets
+
