+-- BEGIN ROF2 ORIGIN UNIVERSAL ENTITLEMENT
+-- Requires the reviewed native Origin-only durable receipt binding.
+local origin_entitlement = require("aa_origin_entitlement")
+local origin_previous_connect = event_connect
+function event_connect(e)
+    local result
+    if origin_previous_connect then result = origin_previous_connect(e) end
+    if result and result ~= 0 then return result end
+    origin_entitlement.reconcile(e.self)
+    return result
+end
+local origin_previous_level_up = event_level_up
+function event_level_up(e)
+    local result
+    if origin_previous_level_up then result = origin_previous_level_up(e) end
+    if result and result ~= 0 then return result end
+    origin_entitlement.reconcile(e.self)
+    return result
+end
