+inline const Requirement* Find(uint32_t id) noexcept {
+ for (const auto& r : Requirements) if (r.recipe == id) return &r;
+ return nullptr;
+}
+inline int SummonCount(uint32_t recipe, uint32_t output, int count) {
+ const auto* r = Find(recipe);
+ // Native -1 means unlimited charges on ONE nonstack item. Physical yield and credit stay one.
+ return r && r->charges == -1 && r->output == output && count == 1 ? -1 : count;
+}
