 IF ROW_COUNT()<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='RRC309 Shield definition delete mismatch'; END IF;
 IF (SELECT COUNT(*)FROM items)<>items_before-1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='RRC309 Shield definition rollback count mismatch'; END IF;
 COMMIT;
 SET own_transaction=FALSE;
 SELECT 'RRC309_ITEM_ROLLBACK'AS phase,items_before,(SELECT COUNT(*)FROM items)AS items_after,@@in_transaction AS in_transaction;
END$$
