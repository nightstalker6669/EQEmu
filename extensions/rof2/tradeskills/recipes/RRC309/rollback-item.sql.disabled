-- Separate definition-only phase. Exact coordinator GO and fresh authorized connection required.
DELIMITER $$
CREATE PROCEDURE rrc309_item_rollback()
BEGIN
 DECLARE own_transaction BOOL DEFAULT FALSE;
 DECLARE items_before BIGINT DEFAULT 0;
 DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN IF own_transaction THEN ROLLBACK; END IF; RESIGNAL; END;
