 inline const Requirement* Find(std::uint32_t id) noexcept {
  constexpr auto first=Requirements[0].recipe_id;
  constexpr auto count=sizeof(Requirements)/sizeof(Requirements[0]);
- if(id<first || id-first>=count)return nullptr;
- const auto& requirement=Requirements[id-first];
- return requirement.recipe_id==id ? &requirement : nullptr;
+ if(id>=first && id-first<count) {
+  const auto& requirement=Requirements[id-first];
+  if(requirement.recipe_id==id)return &requirement;
+ }
+ constexpr std::uint32_t existing_count=sizeof(ExistingRequirements)/sizeof(ExistingRequirements[0]);
+ std::uint32_t low=0,high=existing_count;
+ while(low<high) {
+  const auto middle=low+(high-low)/2;
+  if(ExistingRequirements[middle].recipe_id<id)low=middle+1;else high=middle;
+ }
+ return low<existing_count && ExistingRequirements[low].recipe_id==id ? &ExistingRequirements[low] : nullptr;
 }
