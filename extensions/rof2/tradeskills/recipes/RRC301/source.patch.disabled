+bool Client::ValidateHousingRecipe301(const HousingRecipe301::Binding& b) {
+ try {
+  if(!NativeFurniture(this)||!Connected()||!ClientDataLoaded()||!HasInventorySessionReservation()||!m_housing_placement_session||
+   CharacterID()!=b.actor||AccountID()!=b.account||!b.owner||InventorySessionReleaseTicket()!=b.owner||!b.owner->HeldFor(*this)||!zone||zone->GetZoneID()!=712||zone->GetZoneID()!=b.zone||
+   zone->GetInstanceID()!=b.instance||zone->GetInstanceVersion()!=b.version||!b.stored.placement||b.stored.row.values.item_id!=54250)return false;
+  auto& session=*m_housing_placement_session;const auto& p=*b.stored.placement;
+  auto cached=session.presentations.find(p.reservation.native_item_id);if(cached==session.presentations.end()||!cached->second||cached->second->GetID()!=54250||FurnitureGuid(*cached->second)!=b.guid)return false;
+  auto view=LoadHousingView(this);auto* bridge=GetHousingInventoryBridge();if(!view||view->interior||!bridge)return false;
+  auto target=FurniturePlot(this,*view,*cached->second,p.reservation.native_estate_id);if(!target||target->room)return false;
+  auto fresh=FurnitureSnapshot(this,*bridge,*target);if(!fresh||fresh->native_plot_id!=b.native_plot||fresh->estate_id!=b.stored.estate_id||fresh->current_catalog_revision!=b.catalog_revision||fresh->acl_revision!=b.acl_revision||!FurniturePlayerInRegion(this,*fresh)||!fresh->access.Allows(Housing::AccessPolicy::Capability::InteractItem))return false;
+  auto regions=fresh->additional_regions;regions.insert(regions.begin(),fresh->region);if(regions.size()!=b.regions.size())return false;for(size_t n=0;n<regions.size();++n)if(regions[n].id!=b.regions[n].id||regions[n].matrix!=b.regions[n].matrix)return false;
+  if(!Housing::RentState::Plot(database,fresh->estate_id,fresh->native_plot_id,false).Active())return false;
+  for(const auto& entry:fresh->items) {
+   const auto& row=entry.stored;
+   if(row.custody_id!=b.stored.custody_id||!row.placement||row.stowed||entry.contained_in_crate||row.storage_revision!=b.stored.storage_revision||row.row.values.item_id!=54250||Housing::CustodyCodec::Encode(row.row)!=Housing::CustodyCodec::Encode(b.stored.row))continue;
+   if(row.placement->reservation.native_estate_id!=p.reservation.native_estate_id||row.placement->reservation.native_item_id!=p.reservation.native_item_id||row.placement->pose_revision!=p.pose_revision||!FurnitureSameTransform(row.placement->transform,p.transform)||!FurnitureCurrentCatalog(row,*target,fresh->current_catalog_revision)||!Housing::InventoryBridge::MatchesProjection(row.row,*cached->second)||!Housing::HousePresentation::Matches(entry,*cached->second))return false;
+   auto scene=FurnitureCurrentScene(this,session,*bridge,*target);if(!scene||!scene->entries.count(p.reservation.native_item_id))return false;
+   auto distance=FurnitureDistance(this,*cached->second,p.transform);return distance&&*distance<=20;
+  }
+  return false;
+ }catch(...){return false;}
+}
