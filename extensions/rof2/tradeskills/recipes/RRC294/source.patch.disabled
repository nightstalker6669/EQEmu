+ {3102655,72627,10,75,17149,72611,10,10,1},
+ {3102656,72629,10,75,17149,72615,10,10,1},
+ {3102657,72630,10,75,17149,72616,10,10,1},
+ {3102658,72634,5,75,17149,72600,5,5,1},
+ {3102659,72636,5,75,17149,72602,5,5,1},
+ {3102660,72637,5,75,17149,72603,5,5,1},
+ {3102661,72639,5,75,17149,72609,5,5,1},
+ {3102662,72640,5,75,17149,72610,5,5,1},
+ {3102663,72641,5,75,17149,72611,5,5,1},
