+#pragma once
+#include <cstdint>
+// Exact32 positive-source charged outcomes only. All SQL success quantities
+// stay PHYSICAL; task/craft counts are not the item factory charge argument.
+namespace ChargedRecipe32 {
+struct Requirement {uint32_t recipe,output,charges,skill,kit,input,units,cells,maxsize;};
+inline constexpr Requirement Requirements[]={
+ {3102639,11454,10,75,17149,10270,10,10,1},
