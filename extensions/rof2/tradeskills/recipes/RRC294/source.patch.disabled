+ {3102670,97921,60,57,17877,0,0,8,2},
+};
+inline const Requirement* Find(uint32_t recipe)noexcept{for(const auto& r:Requirements)if(r.recipe==recipe)return &r;return nullptr;}
+inline int16_t SummonCount(uint32_t recipe,uint32_t item,uint8_t physical)noexcept{const auto* r=Find(recipe);return r&&r->output==item&&physical==1?int16_t(r->charges):int16_t(physical);}
+}
