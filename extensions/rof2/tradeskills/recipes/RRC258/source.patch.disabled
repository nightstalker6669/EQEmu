+inline const Requirement* Find(std::uint32_t id) noexcept {
+ constexpr auto first=Requirements[0].recipe_id;
+ constexpr auto count=sizeof(Requirements)/sizeof(Requirements[0]);
+ if(id<first || id-first>=count)return nullptr;
+ const auto& requirement=Requirements[id-first];
+ return requirement.recipe_id==id ? &requirement : nullptr;
+}
+inline bool Allows(const Requirement& r,std::uint32_t skill,std::uint32_t race,
+ std::uint32_t zone_id,std::uint32_t db_id,std::uint32_t object_type,
+ std::uint32_t actual_item_id,std::uint32_t actual_slots) noexcept {
+ return skill==static_cast<std::uint32_t>(EQ::skills::SkillBlacksmithing) &&
+  race==r.profile_race && zone_id==r.zone_id && db_id==r.object_db_id &&
+  object_type==r.object_type && actual_item_id==r.container_item_id &&
+  actual_slots>=r.minimum_slots;
+}
+}
