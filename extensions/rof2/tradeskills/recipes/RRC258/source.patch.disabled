+		const auto* item = station && station->m_inst ? station->m_inst->GetItem() : nullptr;
+		if (!station || station->user != user || !station->m_inst ||
+			!station->m_inst->IsType(EQ::item::ItemClassBag) ||
+			rac->object_type != station->GetType() ||
