+bool NativeEvents::AcceptSceneEcho(const void* bytes,uint32_t size,uint32_t task,uint32_t activity,uint32_t count) {
+ if(task!=920144||activity!=10||count!=1||!zone||zone->GetZoneID()!=481||zone->GetInstanceVersion()!=1||!zone->GetInstanceID())return false;
+ FungalItemWire::Trailer t;
+ if(!FungalItemWire::ReadHeader(bytes,size,sizeof(ServerSharedTaskActivityUpdate_Struct),t)||
+  t.kind!=FungalItemWire::Delivery||!t.outcome||t.instance!=zone->GetInstanceID())return false;
+ auto ack=FungalInventory::NativeCustody::ReadKnownDeliveryAck(database,t,task,activity,count);
+ if(!ack||ack->facts_.task!=920144||ack->facts_.scope!=2||ack->facts_.occurrence!=t.run||
+  ack->facts_.instance!=t.instance||ack->effect_.activity!=10||ack->effect_.receipt!=t.outcome)return false;
+ ReconcileDeliveryScene();return true;
+}
+void NativeEvents::ReconcileDeliveryScene() {
+ if(!zone||zone->GetZoneID()!=481||zone->GetInstanceVersion()!=1||!zone->GetInstanceID()||
+  delivery_scene_attempt==zone->GetInstanceID())return;
+ // This reader requires the exact physical delivery10 ACK, the original live
+ // mission/DZ/lease and native11active. Task history alone cannot open a scene.
+ auto ack=FungalInventory::NativeCustody::ReadMissionDeliveryAck(database,481,1,zone->GetInstanceID());
+ if(!ack||ack->facts_.task!=920144||ack->facts_.scope!=2||ack->facts_.zone!=481||ack->facts_.version!=1||
+  ack->facts_.instance!=zone->GetInstanceID()||!ack->facts_.dynamic_zone||
+  ack->effect_.activity!=10||ack->effect_.target_count!=1||!ack->effect_.receipt)return;
+ // Consume BEFORE the native setter can invoke mutable spawn callbacks. It has
+ // no checked persistence result, so never retry an ambiguous local attempt.
+ delivery_scene_attempt=zone->GetInstanceID();
+ if(!FungalInventory::NativeCustody::ClaimDeliveryScene(database,*ack))return;
+ if(zone->spawn_conditions.GetCondition(zone->GetShortName(),zone->GetInstanceID(),6204)==1)return;
+ zone->spawn_conditions.SetCondition(zone->GetShortName(),zone->GetInstanceID(),6204,1);
+}
