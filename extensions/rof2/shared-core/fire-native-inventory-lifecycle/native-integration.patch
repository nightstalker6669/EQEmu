+uint64_t FireReceiptNumber(const char* value) {
+ if(!value || !*value) throw std::runtime_error("Fire receipt null number");
+ uint64_t n=0;const auto end=value+std::strlen(value);
+ const auto result=std::from_chars(value,end,n);
+ if(result.ec!=std::errc{} || result.ptr!=end) throw std::runtime_error("Fire receipt invalid number");
+ return n;
+}
+int64_t FireReceiptSigned(const char* value) {
+ if(!value || !*value) throw std::runtime_error("Fire receipt null signed field");
+ int64_t n=0;const auto end=value+std::strlen(value);
+ const auto result=std::from_chars(value,end,n);
+ if(result.ec!=std::errc{} || result.ptr!=end) throw std::runtime_error("Fire receipt invalid signed field");
+ return n;
+}
+MySQLRequestResult FireReceiptQuery(Database& db,const std::string& sql) {
+ if(db.GetStatus()!=DBcore::Connected) throw std::runtime_error("Fire receipt disconnected");
+ auto result=db.QueryDatabase(sql,false);
+ if(!result.Success()) throw std::runtime_error("Fire receipt query failed");
+ return result;
+}
+uint64_t FireReceiptFreshSession(Database& db) {
+ auto q=FireReceiptQuery(db,"SELECT CONNECTION_ID(),@@in_transaction,@@autocommit");
+ if(q.RowCount()!=1 || FireReceiptNumber(q.begin()[1])!=0 ||
+  FireReceiptNumber(q.begin()[2])!=1) throw std::runtime_error("Fire receipt nested session");
+ return FireReceiptNumber(q.begin()[0]);
+}
+void FireReceiptFoundation(Database& db) {
+ auto q=FireReceiptQuery(db,"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() "
+  "AND engine='InnoDB' AND table_name IN ('rof2_fire_construct_death_receipts','character_tasks',"
+  "'character_activities','character_task_reward_instances')");
+ if(q.RowCount()!=1 || FireReceiptNumber(q.begin()[0])!=4)
+  throw std::runtime_error("Fire receipt transactional foundation differs");
+}
