+  item->GetItem()&&item->GetItem()->MaxCharges==1&&item->GetItem()->Click.Effect==7651&&item->GetItem()->Click.Type==3&&
+  NativeRunItemOrigins::HasActualPublishedOrigin(c,*item,f.clicked.slot,f.mission);
