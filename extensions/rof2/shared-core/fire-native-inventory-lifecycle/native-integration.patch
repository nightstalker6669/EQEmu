+
+bool ConstructDeathReceiptStore::PersistActualDeath(Database& db,const OriginalConstructAttempt& actual) {
+ if(actual.original_.personal.acceptance.task_id!=920167 || !actual.caster_death_submitted_ ||
+  !actual.caster_death_committed_)return false;
+ return PersistSavedRecipient(db,actual,actual.original_.personal.acceptance);
+}
+bool ConstructDeathReceiptStore::PersistActualParticipant(Database& db,const OriginalConstructAttempt& actual,
+ const NativeConstructParticipantVisit& visit) {
+ if(!UsesBoundedNativeGroupCredit(actual.original_.personal.acceptance.task_id) ||
+  !visit.observed_ || !visit.submitted_ || !visit.saved_ || visit.persisted_ ||
+  !actual.caster_death_submitted_)return false;
+ bool owned_visit=false;
+ for(size_t i=0;i<actual.activation_count_;++i)
+  if(&actual.native_visits_[i]==&visit &&
+   actual.activation_cohort_[i].original.character_id==visit.recipient_.character_id &&
+   actual.activation_cohort_[i].original.occurrence_id==visit.recipient_.occurrence_id)owned_visit=true;
+ if(!owned_visit)return false;
+ return PersistSavedRecipient(db,actual,visit.recipient_);
+}
+bool ConstructDeathReceiptStore::PersistSavedRecipient(Database& db,const OriginalConstructAttempt& actual,
+ const Binding& b) {
+ if(!actual.captured_ || !actual.death_success_sealed_ || !actual.native_click_sequence_)return false;
+ const auto& identity=*actual.captured_;const auto& use=actual.original_;
+ const auto& creator=use.personal.acceptance;const auto rule=OriginalRule(creator.task_id);
+ if(!rule || b.task_id!=creator.task_id || !b.character_id || !b.occurrence_id ||
+  b.slot<0 || b.slot>=MAXACTIVEQUESTS || b.accepted_time<=0 ||
+  !creator.character_id || !creator.occurrence_id || creator.accepted_time<=0 ||
+  creator.slot<0 || creator.slot>=MAXACTIVEQUESTS ||
+  use.personal.consumer!=Consumer::ActivateConstruct || use.item_id!=rule->inactive_item ||
+  !use.item_serial || use.charges_before<=0 || !use.caster_entity ||
+  identity.npc_type_id!=rule->construct_npc || !identity.entity_id ||
+  identity.zone_id!=rule->encounter_zone || identity.instance_id!=0)return false;
+ bool transaction=false;
+ try {
+  const auto connection=FireReceiptFreshSession(db);
+  if(!db.TransactionBeginStrict().Success())return false;
+  transaction=true;FireReceiptFoundation(db);FireReceiptStage(db,b);
+  const auto inserted=FireReceiptQuery(db,fmt::format(
+   "INSERT INTO rof2_fire_construct_death_receipts (character_id,task_id,occurrence_id,accepted_time,"
+   "accepted_slot,creator_character_id,creator_task_id,creator_occurrence_id,creator_accepted_time,"
+   "creator_accepted_slot,native_click_sequence,original_item_id,original_item_serial,original_item_slot,"
+   "original_charges,original_caster_entity,original_target_entity,construct_npc_id,construct_entity_id,"
+   "construct_spawn_id,construct_zone_id,construct_instance_id,saved_at,claimed_at) "
+   "VALUES ({},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},UNIX_TIMESTAMP(),NULL)",
+   b.character_id,b.task_id,b.occurrence_id,b.accepted_time,b.slot,
+   creator.character_id,creator.task_id,creator.occurrence_id,creator.accepted_time,creator.slot,
+   actual.native_click_sequence_,use.item_id,use.item_serial,use.slot,use.charges_before,
+   use.caster_entity,use.requested_target_entity,identity.npc_type_id,identity.entity_id,
+   identity.spawn_point_id,identity.zone_id,identity.instance_id));
+  if(inserted.RowsAffected()!=1)throw std::runtime_error("Fire recipient receipt insert not exact");
+  FireReceiptBeforeCommit(db,connection);
+  const auto commit=db.TransactionCommitStrict();transaction=false;
+  return commit.Success(); // no unknown-commit readback/replay/upsert/retry
+ } catch(const std::exception&) {if(transaction)db.TransactionRollbackStrict();return false;}
+}
+
+std::shared_ptr<PersistedConstructFinish> ConstructDeathReceiptStore::ClaimForActualHail(
+ Database& db,Client& client,NPC& giver,const ClientTaskInformation& current) {
+ if(!zone || zone->GetZoneID()!=490 || zone->GetInstanceID()!=0 ||
+  giver.GetNPCTypeID()!=490061 || !giver.GetID() || !giver.GetSpawnPointID() ||
+  (current.task_id!=920167 && current.task_id!=920168 && current.task_id!=920169) || current.slot<0 ||
+  current.slot>=MAXACTIVEQUESTS || current.accepted_time<=0 || current.was_rewarded ||
+  current.activity[2].activity_state!=ActivityCompleted ||
+  current.activity[3].activity_state!=ActivityActive) return {};
+ bool transaction=false;
+ try {
+  const auto connection=FireReceiptFreshSession(db);
+  if(!db.TransactionBeginStrict().Success()) return {};
+  transaction=true;FireReceiptFoundation(db);
+  auto q=FireReceiptQuery(db,fmt::format(
+   "SELECT p.occurrence_id,p.native_click_sequence,p.original_item_id,p.original_item_serial,p.construct_npc_id,"
+   "p.construct_entity_id,p.construct_zone_id,p.construct_instance_id,p.original_caster_entity,p.original_charges,p.creator_character_id,p.creator_task_id, "
+   "p.creator_occurrence_id,p.creator_accepted_time,p.creator_accepted_slot "
+   "FROM rof2_fire_construct_death_receipts p JOIN character_task_reward_instances r "
+   "ON r.character_id=p.character_id AND r.task_id=p.task_id AND r.occurrence_id=p.occurrence_id "
+   "AND r.accepted_time=p.accepted_time WHERE p.character_id={} AND p.task_id={} AND p.accepted_time={} "
+   "AND p.accepted_slot={} AND p.claimed_at IS NULL FOR UPDATE",
+   client.CharacterID(),current.task_id,current.accepted_time,current.slot));
+  if(q.RowCount()!=1) throw std::runtime_error("Fire receipt absent or ambiguous");
+  auto row=q.begin();
+  Binding b{client.CharacterID(),static_cast<uint32_t>(current.task_id),current.slot,
+   current.accepted_time,FireReceiptNumber(row[0])};
+  const auto rule=OriginalRule(b.task_id);
+  if(!rule || !MatchesLocal(b,client.CharacterID(),TaskType::Quest,current) ||
+   !FireReceiptNumber(row[1]) || FireReceiptNumber(row[2])!=rule->inactive_item ||
+   !FireReceiptSigned(row[3]) || FireReceiptNumber(row[4])!=rule->construct_npc ||
+   !FireReceiptNumber(row[5]) || FireReceiptNumber(row[6])!=rule->encounter_zone ||
+   FireReceiptNumber(row[7])!=0 || !FireReceiptNumber(row[8]) || FireReceiptSigned(row[9])<=0 ||
+   !FireReceiptNumber(row[10]) || FireReceiptNumber(row[11])!=b.task_id ||
+   !FireReceiptNumber(row[12]) || FireReceiptSigned(row[13])<=0 ||
+   FireReceiptSigned(row[14])<0 || FireReceiptSigned(row[14])>=MAXACTIVEQUESTS)
+   throw std::runtime_error("Fire receipt original event identity differs");
+  FireReceiptStage(db,b);
+  // Allocate the actual opaque handoff before persistence. It becomes authority
+  // only after the exact claim COMMIT response, never from a count/history row.
+  auto finish=std::shared_ptr<PersistedConstructFinish>(new PersistedConstructFinish(b,client,giver));
+  auto claim=FireReceiptQuery(db,fmt::format(
+   "UPDATE rof2_fire_construct_death_receipts SET claimed_at=UNIX_TIMESTAMP() "
+   "WHERE character_id={} AND task_id={} AND occurrence_id={} AND claimed_at IS NULL",
+   b.character_id,b.task_id,b.occurrence_id));
+  if(claim.RowsAffected()!=1) throw std::runtime_error("Fire receipt claim not exact");
+  FireReceiptBeforeCommit(db,connection);
+  const auto commit=db.TransactionCommitStrict();transaction=false;
+  if(!commit.Success()) return {};
+  return finish;
+ } catch(const std::exception&) {
+  if(transaction) db.TransactionRollbackStrict();
+  return {};
+ }
+}
+
+void PersistedConstructFinish::Submit(Client& client,NPC& giver,const ClientTaskInformation& current) {
+ if(used_ || owner_!=&client) return;
+ used_=true; // before any validation query, allocation or native mutable effect
+ if(giver.GetID()!=giver_entity_ || giver.GetSpawnPointID()!=giver_spawn_) return;
+ SubmitActualOriginalFinalHailOnce(database,hail_,client,TaskType::Quest,current,giver,490,0,giver_spawn_);
+ // Only this retained private object may be accessed after mutable callbacks.
+}
