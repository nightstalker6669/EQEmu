+ auto expiry=database.QueryDatabase(fmt::format("SELECT expire_at FROM instance_list WHERE id={} AND never_expires=0 AND expire_at={} AND expire_at>UNIX_TIMESTAMP()",f.mission.instance,f.instance_expire_at),false);
