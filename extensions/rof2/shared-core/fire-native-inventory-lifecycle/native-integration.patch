+  "SELECT r.occurrence_id FROM character_task_reward_instances r JOIN character_tasks ct "
+  "ON ct.charid=r.character_id AND ct.taskid=r.task_id AND ct.acceptedtime=r.accepted_time "
+  "WHERE r.character_id={} AND r.task_id={} AND r.occurrence_id={} AND r.accepted_time={} "
+  "AND ct.slot={} AND ct.type=2 AND ct.was_rewarded=0 FOR UPDATE",
+  b.character_id,b.task_id,b.occurrence_id,b.accepted_time,b.slot));
+ if(pointer.RowCount()!=1 || FireReceiptNumber(pointer.begin()[0])!=b.occurrence_id)
+  throw std::runtime_error("Fire receipt accepted occurrence differs");
+ auto activity=FireReceiptQuery(db,fmt::format(
+  "SELECT activityid,donecount,completed FROM character_activities WHERE charid={} "
+  "AND taskid={} ORDER BY activityid FOR UPDATE",b.character_id,b.task_id));
+ if(activity.RowCount()!=4) throw std::runtime_error("Fire receipt activity universe differs");
+ unsigned i=0;
+ for(auto row=activity.begin();row!=activity.end();++row,++i) {
+  const uint64_t expected_done=i==1?10:(i==3?0:1);
+  if(FireReceiptNumber(row[0])!=i || FireReceiptNumber(row[1])!=expected_done ||
+   FireReceiptNumber(row[2])!=(i==3?0:1))
+   throw std::runtime_error("Fire receipt exact saved stage differs");
+ }
+}
+void FireReceiptBeforeCommit(Database& db,uint64_t connection) {
+ auto q=FireReceiptQuery(db,"SELECT CONNECTION_ID(),@@in_transaction");
+ if(q.RowCount()!=1 || FireReceiptNumber(q.begin()[0])!=connection ||
+  FireReceiptNumber(q.begin()[1])!=1 || db.TransactionStrictFailed())
+  throw std::runtime_error("Fire receipt strict session changed");
+}
