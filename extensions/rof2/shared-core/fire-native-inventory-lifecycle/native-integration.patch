+   for(const auto slot:c.GetInventorySlots()) {
+    if(!CarriedSlot(c,slot))continue;const auto* item=c.GetInv().GetItem(slot);
+    if(!item||item->GetID()!=f.required_item_ids[i]||!item->GetSerialNumber()||item->IsStackable()||
