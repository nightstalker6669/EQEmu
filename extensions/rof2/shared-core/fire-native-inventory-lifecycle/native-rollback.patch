-  client.CharacterID()!=binding.character_id || client.GetID()!=original.caster_entity ||
-  !zone || zone->GetZoneID()!=original.actual_zone ||
-  zone->GetInstanceID()!=original.actual_instance || !client.GetTaskState()) return;
